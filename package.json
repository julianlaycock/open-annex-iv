{
  "name": "open-annex-iv",
  "version": "1.0.0",
  "description": "Open-source AIFMD Annex IV XML serialization library. Converts plain report objects to ESMA-compliant XML.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx tests/serializer.test.ts && tsx tests/serializer-strict.test.ts",
    "test:xsd": "tsx tests/xsd-validation.test.ts",
    "prepublishOnly": "npm run build"
  },
  "optionalDependencies": {
    "libxmljs2": "^0.37.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "aifmd",
    "annex-iv",
    "esma",
    "xml",
    "compliance",
    "regulatory",
    "fund-reporting",
    "aifmd-ii",
    "regulatory-reporting",
    "fund-management",
    "bafin",
    "cssf"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julianlaycock/open-annex-iv"
  },
  "homepage": "https://www.caelith.tech",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/julianlaycock/open-annex-iv/issues"
  },
  "author": "Caelith Technologies (https://caelith.tech)",
  "dependencies": {
    "zod": "^3.22.0"
  }
}
